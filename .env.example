# Copy to .env.local and enter credentials locally. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Direct or session-compatible connection for migrations/worker; verify with pg-boss.
DATABASE_URL=
OPENAI_API_KEY=
# Select a model after checking project access and extraction quality.
OPENAI_MODEL=
FIRECRAWL_API_KEY=
# Static integration token OR OAuth app credentials, not necessarily both.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
# Map the server-side HubSpot credential to exactly one tenant. Leave writes off until verified.
HUBSPOT_TENANT_ID=
HUBSPOT_TEST_WRITES_ENABLED=false
# Set true for an authenticated-only hosted installation.
LEADRADAR_DISABLE_DEMO=false
# Optional persistent local demo directory; default .leadradar (ignored).
LEADRADAR_DATA_DIR=
# Signed inbound tender notices (POST /api/tender/inbound). Secret >= 32 chars; tenant = workspace uuid;
# user = an admin member of that workspace (re-checked by the worker). Leave empty to disable.
TENDER_WEBHOOK_SECRET=
TENDER_WEBHOOK_TENANT_ID=
TENDER_WEBHOOK_USER_ID=
# Worker refresh schedule (cron, UTC). Default: 15 5 * * *
LEADRADAR_REFRESH_CRON=
